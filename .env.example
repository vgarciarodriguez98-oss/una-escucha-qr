# Use `wrangler secret put` in production. Do not commit a .dev.vars file.
ADMIN_PASSWORD=replace-with-a-long-random-password
VISITOR_PEPPER=replace-with-at-least-32-random-bytes
AUTH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes

# Local-only convenience. Set false only for plain http://localhost.
COOKIE_SECURE=false
